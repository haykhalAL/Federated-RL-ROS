<launch>
  <!-- Launch Gazebo with your maze world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <!-- <arg name="world_name" value="$(find maze_map)/worlds/maze.world"/> -->
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
  </include>

  <!-- Load TurtleBot3 URDF -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(env TURTLEBOT3_MODEL).urdf.xacro"/>

  <!-- Robot launcher -->
  <node pkg="dev_fl_robot_pkg"
        type="robot_launcher.py"
        name="robot_launcher"
        output="screen"/>

  <!-- DQN experiment -->
  <node pkg="dev_fl_robot_pkg"
        type="train_dqn.py"
        name="train_dqn"
        output="screen"
        args="--config $(find dev_fl_robot_pkg)/scripts/config/experiment_config.yaml"/>
</launch>